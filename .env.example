# Copy this file to .env and fill in your own values. Never commit .env.

# Voice coaching - free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional locally, needed in the cloud: lets the webcam stream use
# Hugging Face's free TURN relay. Token from https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_read_token_here
